# Скопируйте в .env (он в .gitignore) и заполните. Секреты — только в .env.

# Домен в Matrix ID: @имя:SERVER_NAME. После первого запуска менять нельзя.
SERVER_NAME=example.org
# Публичный адрес homeserver (обратный прокси → 127.0.0.1:HOMESERVER_PORT)
HOMESERVER_URL=https://matrix.example.org

# Версия образа Continuwuity — конкретный тег, не latest:
# https://forgejo.ellis.link/continuwuation/continuwuity/releases
CONTINUWUITY_VERSION=

# Ключи Web Push: pnpm --filter @redline/push-gateway vapid
VAPID_SUBJECT=mailto:admin@example.org
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Если FCM/Apple недоступны напрямую — HTTP(S)-прокси для исходящих push
PUSH_PROXY=

# Боты (рендер m.notice карточкой, метка «бот»), через запятую
BOT_USERS=@mari:example.org

# Локальные порты на 127.0.0.1
HOMESERVER_PORT=8008
CHAT_PORT=8090

# --- Сайт Minecraft-сервера (apps/site) ---
SITE_URL=https://minecraft.example.org
# адрес, который игроки вводят в Minecraft (его же сайт пингует для онлайна)
MC_SERVER_ADDRESS=mc.example.org
# 3D-карта; пусто — SITE_URL/map/
MAP_URL=
SITE_PORT=8000
