# Шаблон: при старте envsubst подставляет HOMESERVER_URL (см. NGINX_ENVSUBST_FILTER в Dockerfile).
# Адрес клиента: Caddy дописывает его последним в X-Forwarded-For (иначе — адрес соединения)
map $http_x_forwarded_for $rl_client_ip {
    ~([^,\s]+)\s*$ $1;
    default $remote_addr;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    charset utf-8;
    client_max_body_size 1k;

    gzip on;
    gzip_proxied any;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml application/manifest+json;

    set $csp "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; media-src 'self' blob: data:; font-src 'self'; connect-src 'self' ${HOMESERVER_URL} blob: data:; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'";

    # вход по номеру: тот же процесс, что и push-шлюз. Переменная + resolver: nginx стартует, даже если push недоступен
    resolver 127.0.0.11 valid=30s;
    location /api/phone/ {
        include /etc/nginx/redline-headers.conf;
        add_header Cache-Control "no-store" always;
        client_max_body_size 4k;
        set $phone_upstream http://push:8080;
        proxy_set_header X-Real-IP $rl_client_ip;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Host $host;
        proxy_pass $phone_upstream;
    }

    # вход по паролю: Caddy шлёт сюда только /login, шлюз считает неудачные попытки и пересылает на homeserver.
    # Ответ предназначен другому origin, поэтому без CSP и security-заголовков; URI с query передаётся как есть
    location ~ ^/_matrix/client/(r0|v3)/login$ {
        client_max_body_size 8k;
        set $push_upstream push:8080;
        proxy_set_header X-Real-IP $rl_client_ip;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Host $host;
        proxy_pass http://$push_upstream;
    }

    # файлы с хешем в имени — навсегда
    location /assets/ {
        include /etc/nginx/redline-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # оболочка, service worker и конфиг — всегда свежие, иначе обновление не дойдёт
    location ~ ^/(index\.html|sw\.js|config\.json|manifest\.webmanifest)$ {
        include /etc/nginx/redline-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/redline-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
