{
  "name": "@redline/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Дизайн-система Redline: токены, красные линии, компоненты",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./index.css": "./src/index.css",
    "./tokens.css": "./src/tokens.css",
    "./base.css": "./src/base.css",
    "./components.css": "./src/components.css",
    "./red-lines.css": "./src/red-lines.css",
    "./red-lines.js": "./src/red-lines.js"
  },
  "sideEffects": [
    "*.css",
    "./src/red-lines.js",
    "./src/index.js"
  ],
  "scripts": {
    "demo": "node scripts/serve.mjs"
  }
}
